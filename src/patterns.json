{
  "FunctionPattern": "^([ \\t\\r\\n\\f]*)(?:static[ \\t\\r\\n\\f]+)?func[ \\t\\r\\n\\f]+([A-Za-z0-9_]+)[ \\t\\r\\n\\f]*\\(",
  "SignalPattern": "^([ \\t\\r\\n\\f]*)signal[ \\t\\r\\n\\f]+([A-Za-z0-9_]+)",
  "ConstantPattern": "^([ \\t\\r\\n\\f]*)const[ \\t\\r\\n\\f]+([A-Z_][A-Z0-9_]*)[ \\t\\r\\n\\f]*[=:]",
  "EnumPattern": "^([ \\t\\r\\n\\f]*)enum[ \\t\\r\\n\\f]+([A-Za-z0-9_]+)[ \\t\\r\\n\\f]*\\{",
  "EnumValuePattern": "^[ \\t\\r\\n\\f]*([A-Z_][A-Z0-9_]*)[ \\t\\r\\n\\f]*(?:[,=]|$)",
  "ClassNamePattern": "^class_name[ \\t\\r\\n\\f]+([A-Za-z0-9_]+)",
  "ExtendsPattern": "^extends[ \\t\\r\\n\\f]+([A-Za-z0-9_]+)",
  "PreloadPattern": "preload[ \\t\\r\\n\\f]*\\([ \\t\\r\\n\\f]*[\"']([^\"']+)[\"'][ \\t\\r\\n\\f]*\\)",
  "LoadPattern": "load[ \\t\\r\\n\\f]*\\([ \\t\\r\\n\\f]*[\"']([^\"']+)[\"'][ \\t\\r\\n\\f]*\\)",
  "FunctionCallPattern": "(?-u:\\b)([A-Za-z0-9_]+)[ \\t\\r\\n\\f]*\\(",
  "SignalEmitPattern": "([A-Za-z0-9_]+)\\.emit[ \\t\\r\\n\\f]*\\(",
  "SignalConnectPattern": "([A-Za-z0-9_]+)\\.connect[ \\t\\r\\n\\f]*\\(",
  "ConnectCallbackPattern": "\\.connect[ \\t\\r\\n\\f]*\\([ \\t\\r\\n\\f]*([A-Za-z_][A-Za-z0-9_]*)",
  "CallableRefPattern": "(?:[:,=\\[][ \\t\\r\\n\\f]*)((?-u:\\b)_[a-z_][a-z0-9_]*(?-u:\\b))(?:[ \\t\\r\\n\\f]*[,\\]\\}]|[ \\t\\r\\n\\f]*$)",
  "ConstantRefPattern": "(?-u:\\b)([A-Z_][A-Z0-9_]*)(?-u:\\b)",
  "EnumRefPattern": "(?-u:\\b)([A-Za-z0-9_]+)\\.([A-Z_][A-Z0-9_]*)(?-u:\\b)",
  "TypeAnnotationPattern": ":[ \\t\\r\\n\\f]*([A-Za-z0-9_]+)(?:[ \\t\\r\\n\\f]*[,\\)]|[ \\t\\r\\n\\f]*=)",
  "PrintPattern": "(?-u:\\b)print(?:_debug|_rich|_verbose)?[ \\t\\r\\n\\f]*\\(",
  "DebugLogPattern": "(?-u:\\b)DebugLogUtil\\.log[ \\t\\r\\n\\f]*\\(",
  "CommentPattern": "^[ \\t\\r\\n\\f]*#",
  "PassPattern": "^[ \\t\\r\\n\\f]*pass[ \\t\\r\\n\\f]*$",
  "HasMethodPattern": "(?-u:\\b)has_method[ \\t\\r\\n\\f]*\\(",
  "RPCPattern": "^[ \\t\\r\\n\\f]*@rpc",
  "ExportPattern": "^[ \\t\\r\\n\\f]*@export",
  "OnreadyPattern": "^[ \\t\\r\\n\\f]*@onready",
  "ToolPattern": "^[ \\t\\r\\n\\f]*@tool",
  "StringLiteralPattern": "[\"']([^\"']+)[\"']",
  "GetNodePattern": "get_node[ \\t\\r\\n\\f]*\\([ \\t\\r\\n\\f]*[\"']([^\"']+)[\"'][ \\t\\r\\n\\f]*\\)",
  "NodePathPattern": "\\$[\"']?([^\"' \\t\\r\\n\\f]+)[\"']?",
  "IndentPattern": "^([ \\t\\r\\n\\f]*)",
  "StaticFuncPattern": "^[ \\t\\r\\n\\f]*static[ \\t\\r\\n\\f]+func[ \\t\\r\\n\\f]+",
  "GetterSetterPattern": "^[ \\t\\r\\n\\f]*(?:get|set)[ \\t\\r\\n\\f]+([A-Za-z0-9_]+)[ \\t\\r\\n\\f]*\\(",
  "VariantPattern": "(?-u:\\b)Variant(?-u:\\b)",
  "AutoloadPattern": "autoload/([A-Za-z0-9_]+)",
  "ScenePathPattern": "res://[^\"' \\t\\r\\n\\f]+\\.tscn",
  "ScriptPathPattern": "res://[^\"' \\t\\r\\n\\f]+\\.gd",
  "TechDebtPattern": "#[ \\t\\r\\n\\f]*\\[TECH DEBT\\](.*)",
  "IgnorePrintPattern": "#[ \\t\\r\\n\\f]*gdlint-ignore-print",
  "preloadPattern": "(?:const[ \\t\\r\\n\\f]+[A-Za-z0-9_]+[ \\t\\r\\n\\f]*=[ \\t\\r\\n\\f]*)?preload[ \\t\\r\\n\\f]*\\([ \\t\\r\\n\\f]*[\"']([^\"']+\\.gd)[\"']",
  "loadPattern": "(?:const[ \\t\\r\\n\\f]+[A-Za-z0-9_]+[ \\t\\r\\n\\f]*=[ \\t\\r\\n\\f]*)?load[ \\t\\r\\n\\f]*\\([ \\t\\r\\n\\f]*[\"']([^\"']+\\.gd)[\"']",
  "extendsFilePattern": "extends[ \\t\\r\\n\\f]+[\"']([^\"']+\\.gd)[\"']",
  "extResourcePattern": "\\[ext_resource[ \\t\\r\\n\\f]+type=\"Script\"[^\\]]*path=\"res://([^\"]+\\.gd)\"",
  "scriptPathPattern": "script[ \\t\\r\\n\\f]*=[ \\t\\r\\n\\f]*\"res://([^\"]+\\.gd)\"",
  "autoloadPattern": "=\"?\\*res://(.+\\.gd)\"",
  "returnAnnotationPattern": "\\)[ \\t\\r\\n\\f]*->[ \\t\\r\\n\\f]*[^:]+[ \\t\\r\\n\\f]*:"
}
